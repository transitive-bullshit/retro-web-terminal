{
  "name": "retro-web-terminal",
  "version": "0.1.0",
  "description": "An embeddable React terminal with GPU-rendered CRT effects",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": {
    "type": "git",
    "url": "https://github.com/transitive-bullshit/retro-web-terminal",
    "directory": "packages/retro-terminal"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
